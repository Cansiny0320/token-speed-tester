{
  "name": "token-speed-studio",
  "version": "1.0.0",
  "description": "Local Codex and LLM streaming speed benchmark",
  "author": "Cansiny0320",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "openai": "^4.77.3",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "desktopName": "com.cansiny.token-speed-studio.desktop",
  "homepage": "https://github.com/Cansiny0320/token-speed-tester"
}
